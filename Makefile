BIN := $(shell pwd)/.build/release/big-banner
INSTALL_DIR := $(HOME)/bin

BUILD_INFO := Sources/big-banner/BuildInfo.swift

.DEFAULT_GOAL := help

.PHONY: update update-force help build-info build run soft-install hard-install uninstall clean

help: ## Display this help message
	@grep -E '^[a-zA-Z0-9_-]+:.*?## .*$$' $(MAKEFILE_LIST) | sort | awk 'BEGIN {FS = ":.*?## "}; {printf "\033[36m%-20s\033[0m %s\n", $$1, $$2}'

update: ## Install the latest origin/main if the installed build is out of date
	@scripts/update.sh

update-force: ## Same as update, but skip the confirmation prompt
	@scripts/update.sh -f

build-info: ## Generate BuildInfo.swift with the current git hash (* if dirty)
	@hash=$$(git rev-parse HEAD 2>/dev/null || echo unknown); \
	if [ "$$hash" != unknown ] && [ -n "$$(git status --porcelain)" ]; then hash="$$hash*"; fi; \
	printf '// Generated by `make build-info`; do not edit or commit.\nlet buildHash = "%s"\n' "$$hash" > $(BUILD_INFO)

build: build-info ## Build the release binary
	swift build -c release

run: build ## Build and run big-banner with TEXT
	$(BIN) $(TEXT)

soft-install: build ## Build and symlink into ~/bin
	mkdir -p $(INSTALL_DIR)
	ln -sf $(BIN) $(INSTALL_DIR)/big-banner
	ln -sf $(BIN) $(INSTALL_DIR)/b

hard-install: build ## Build and copy into ~/bin
	mkdir -p $(INSTALL_DIR)
	cp $(BIN) $(INSTALL_DIR)/big-banner
	ln -sf $(INSTALL_DIR)/big-banner $(INSTALL_DIR)/b

uninstall: ## Remove installed binaries from ~/bin
	rm -f $(INSTALL_DIR)/big-banner $(INSTALL_DIR)/b

clean: ## Clean build artifacts
	swift package clean
